generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id              String  @id
  kind            String
  name            String
  price           Int
  image           String
  concern         String?
  refImageUrl     String?
  garmentCategory String?

  tryOnResults TryOnResult[]
}

model SkinAnalysisResult {
  id        String   @id @default(cuid())
  sessionId String
  taskId    String   @unique
  concerns  String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model TryOnResult {
  id        String   @id @default(cuid())
  sessionId String
  taskId    String   @unique
  productId String
  resultUrl String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([sessionId])
}

/// Visitor / activity events for the owner dashboard
model VisitEvent {
  id        String   @id @default(cuid())
  sessionId String
  action    String
  path      String?
  label     String?
  ip        String?
  country   String?
  region    String?
  city      String?
  referer   String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
  @@index([country])
}
