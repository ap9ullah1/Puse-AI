generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id              String  @id
  kind            String
  name            String
  price           Int
  image           String
  concern         String?
  refImageUrl     String?
  garmentCategory String?

  tryOnResults TryOnResult[]
}

model SkinAnalysisResult {
  id        String   @id @default(cuid())
  sessionId String
  taskId    String   @unique
  concerns  String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model TryOnResult {
  id        String   @id @default(cuid())
  sessionId String
  taskId    String   @unique
  productId String
  resultUrl String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([sessionId])
}
