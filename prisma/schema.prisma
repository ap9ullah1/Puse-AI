generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  skinResults  SkinAnalysisResult[]
  tryOnResults TryOnResult[]
  orders       Order[]
}

model Product {
  id              String  @id
  kind            String
  name            String
  price           Int
  image           String
  concern         String?
  refImageUrl     String?
  garmentCategory String?

  tryOnResults TryOnResult[]
}

model SkinAnalysisResult {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  taskId    String   @unique
  concerns  String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
}

model TryOnResult {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  taskId    String   @unique
  productId String
  resultUrl String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
}

/// Visitor / activity events for the owner dashboard
model VisitEvent {
  id        String   @id @default(cuid())
  sessionId String
  action    String
  path      String?
  label     String?
  ip        String?
  country   String?
  region    String?
  city      String?
  referer   String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
  @@index([country])
}

/// Demo checkout orders (hackathon ecommerce loop — no real payments)
model Order {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  items     String
  total     Int
  status    String   @default("demo_confirmed")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
}
